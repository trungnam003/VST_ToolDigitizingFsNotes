<Window x:Class="VST_ToolDigitizingFsNotes.AppMain.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VST_ToolDigitizingFsNotes.AppMain.Views"
        xmlns:vm="clr-namespace:VST_ToolDigitizingFsNotes.AppMain.ViewModels"
        mc:Ignorable="d"
        Title="Số hóa TM BCTC - Vietstock" Height="720" Width="1280" d:DataContext="{d:DesignInstance  Type=vm:MainViewModel}" Icon="/Views/vietstock.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Padding="0 2" Background="#e0e0e0" BorderBrush="#9e9e9e" BorderThickness="0 0 0 1">
            <MenuItem Padding="12 0" Header="View">
                <MenuItem Padding="5 0" Header="Trang chính" Command="{Binding Path=NavigateToHomeCommand}"></MenuItem>
                <MenuItem Padding="5 0" Header="Cài đặt" Command="{Binding Path=NavigateToSettingsCommand}"></MenuItem>
                <MenuItem Padding="5 0" Header="Chạy thử" Command="{Binding Path=NavigateToTestCommand}"></MenuItem>
            </MenuItem>
        </Menu>

        <ContentControl Grid.Row="1" Content="{Binding NavigateService.CurrentViewModel}" />
    </Grid>
</Window>
