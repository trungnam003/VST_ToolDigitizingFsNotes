<UserControl x:Class="VST_ToolDigitizingFsNotes.AppMain.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VST_ToolDigitizingFsNotes.AppMain.Views"
             xmlns:vm="clr-namespace:VST_ToolDigitizingFsNotes.AppMain.ViewModels"
             xmlns:cvt="clr-namespace:VST_ToolDigitizingFsNotes.AppMain.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             Background="#eeeeee"
             Foreground="#212121"
             d:DesignHeight="720" d:DesignWidth="1280"  d:DataContext="{d:DesignInstance Type=vm:HomeViewModel }">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <cvt:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <cvt:DoubleToStringConverter x:Key="DoubleToStringConverter"/>
        <cvt:ListDoubleToStringConverter x:Key="ListDoubleToStringConverter"/>
        <cvt:NegativeValueToBooleanConverter x:Key="NegativeValueToBooleanConverter"/>
        <Style x:Key="CommonButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="5 0"/>
            <Setter Property="Padding" Value="10 2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#bdbdbd"/>
            <Setter Property="Foreground" Value="#212121"/>
            <Setter Property="BorderBrush" Value="#757575"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="{TemplateBinding Margin}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9e9e9e"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#616161"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9e9e9e"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#616161"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="3*" MinWidth="100"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <Button Style="{StaticResource CommonButtonStyle}" Content="Import File"  VerticalAlignment="Center" Command="{Binding SelectFilesCommand}"/>
                    <Button Style="{StaticResource CommonButtonStyle}" Content="Test" VerticalAlignment="Center" Command="{Binding TestCommand}"/>
                    <Button Style="{StaticResource CommonButtonStyle}" Content="Load workspace"  VerticalAlignment="Center" Command="{Binding LoadWorkspaceCommand}"/>
                </StackPanel>
                <GroupBox Header="Danh sách file import" Grid.Row="1" Margin="5" IsEnabled="{Binding WorkspaceViewModel, Converter={StaticResource NullToBoolConverter}}">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Margin="5 0 0 0" Orientation="Horizontal">
                            <Label Content="+ Số lượng file: ">
                            </Label>
                            <Label Content="{Binding WorkspaceViewModel.FileImportFsNoteModels.Count}"></Label>
                            <Button  Style="{StaticResource ResourceKey=CommonButtonStyle}" Content="Chạy số hóa" VerticalAlignment="Center" IsEnabled="{Binding IsNoBlock}" Command="{Binding WorkspaceViewModel.StartCommand}"/>
                            <Label Content="{Binding WorkspaceViewModel.Name}"></Label>
                            <Button Style="{StaticResource CommonButtonStyle}" Content="Xuất" VerticalAlignment="Center" IsEnabled="{Binding IsNoBlock}" Command="{Binding WorkspaceViewModel.ExportDataToFileCommand}"/>
                        </StackPanel>
                        <DataGrid x:Name="dgDataImport" ItemsSource="{Binding WorkspaceViewModel.FileImportFsNoteModels}" SelectedItem="{Binding WorkspaceViewModel.SelectedFileImport}"
                                  Grid.Row="1" AutoGenerateColumns="False" 
                                  IsReadOnly="True" SelectionMode="Single" 
                                  CanUserSortColumns="False"
                                  Foreground="#212121"
                                  HorizontalGridLinesBrush="#212121"
                                  VerticalGridLinesBrush="#212121"
                                  Background="#e0e0e0"
                                  Margin="0 5 0 0" IsEnabled="{Binding IsNoBlock}">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên file" Binding="{Binding Name}"></DataGridTextColumn>
                                <DataGridTextColumn Header="File Lỗi" Binding="{Binding ErrorMessage}"></DataGridTextColumn>
                                <DataGridTextColumn Header="Sheet lỗi" Binding="{Binding WarningMessage}"></DataGridTextColumn>
                            </DataGrid.Columns>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding WorkspaceViewModel.SelectFileImportCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </DataGrid>
                    </Grid>
                </GroupBox>

            </Grid>
            <GridSplitter BorderBrush="#c3c3c3" BorderThickness="1 0" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!--Hover Grid Splitter change color -->
                <GridSplitter.Style>
                    <Style TargetType="{x:Type GridSplitter}">
                        <Setter Property="Background" Value="WhiteSmoke"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#606a75"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </GridSplitter.Style>
            </GridSplitter>
            <Grid Grid.Column="2">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="Auto"></RowDefinition>
                        <RowDefinition Height="*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding WorkspaceViewModel.SelectedFileImport.Name}" FontWeight="Bold" FontSize="12" Margin="5"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Label>Chọn TM:</Label>
                        <ComboBox Cursor="Hand" FontWeight="SemiBold" Width="140" Margin="5" ItemsSource="{Binding WorkspaceViewModel.Sheets}" SelectedItem="{Binding WorkspaceViewModel.SelectedSheetName}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="Blue"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock Text="{Binding WorkspaceViewModel.SelectedSheetInfomation}" Foreground="Blue" FontSize="12"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding WorkspaceViewModel.DataSelected}" 
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True" SelectionMode="Single"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True"
                                  FontSize="14"
                                  CanUserSortColumns="False"
                                  Foreground="#212121"
                                  HorizontalGridLinesBrush="#212121"
                                  VerticalGridLinesBrush="#212121"
                                  Background="#e0e0e0"
                                  EnableColumnVirtualization="True">
                                
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsParent}" Value="True">
                                            <Setter Property="Background" Value="#c2c2c2" />
                                            <Setter Property="Foreground" Value="#1a1a1a" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFormulaCell}" Value="True">
                                            <Setter Property="Background" Value="#b1cee6" />
                                            <Setter Property="Foreground" Value="#1a1a1a" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}"></DataGridTextColumn>
                                <DataGridTextColumn Header="Tên chỉ tiêu" Binding="{Binding Name}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TotalValue, Converter={StaticResource NegativeValueToBooleanConverter}}" Value="-1">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TotalValue, Converter={StaticResource NegativeValueToBooleanConverter}}" Value="1">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Giá trị" FontWeight="SemiBold" Binding="{Binding TotalValue, Converter={StaticResource DoubleToStringConverter}}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TotalValue, Converter={StaticResource NegativeValueToBooleanConverter}}" Value="-1">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TotalValue, Converter={StaticResource NegativeValueToBooleanConverter}}" Value="1">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Cộng dồn" Binding="{Binding Values, Converter={StaticResource ListDoubleToStringConverter}}"></DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
                <!--<GroupBox Header="File được chọn" Margin="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding WorkspaceViewModel.SelectedFileImport.Name}" FontWeight="Bold" FontSize="12" Margin="5" Height="16px"/>
                        </StackPanel>
                       
                    </Grid>
                </GroupBox>-->
            </Grid>
        </Grid>
        <StatusBar BorderBrush="#9e9e9e" BorderThickness="0 1 0 0" Grid.Row="1" Height="30" VerticalAlignment="Center" Background="#e0e0e0">
            <StatusBarItem>
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="Auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="#0d47a1" Grid.Column="0" Text="Đang xử lý:" Margin="3" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ProgressBar Foreground="#1565c0" Background="#eeeeee" Grid.Column="1" x:Name="ProgressBar" Margin="5 0" Width="333" Height="16" IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    </ProgressBar>
                    <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="3" Foreground="#0d47a1"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
